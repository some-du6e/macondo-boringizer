{
    "$schema": "https://json.schemastore.org/chrome-manifest.json",
    "chromium:manifest_version": 3,
    "firefox:manifest_version": 2,
    "manifest_version": 3,
    "version": "1.0.0",
    "browser_specific_settings": {
        "gecko": {
            "id": "{7b9e4f3a-2c61-4d88-a0b4-6f2d9c1e8a73}"
        }
    },
    "name": "Macondo Boringizer",
    "description": "Makes macondo all boring by removing all the fun stuff like the farm and stuff",
    "icons": {
        "16": "icons/icon16.png",
        "32": "icons/icon32.png",
        "48": "icons/icon48.png",
        "128": "icons/icon128.png"
    },
    "host_permissions": ["<all_urls>"],
    "content_scripts": [
        {
            "matches": ["*://macondo.hackclub.com/*"],
            "js": ["entrypoints/dashboard.ts"],
            "run_at": "document_idle"
        },
        {
            "matches": ["*://macondo.hackclub.com/"],
            "js": ["entrypoints/lander.ts"],
            "run_at": "document_idle"
        },
        {
            "matches": ["*://macondo.hackclub.com/profile"],
            "js": ["entrypoints/profile.ts"],
            "run_at": "document_idle"
        }
    ]
}
